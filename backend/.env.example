# Server
PORT=3000
DB_PATH=./data/portfolio.db

# Claude auth via OneCLI (run scripts/setup-claude-auth.sh once to register your
# subscription token with a local OneCLI instance). The backend process itself
# must be launched wrapped as `onecli run -- node dist/index.js` (docker-compose
# / docker-entrypoint.sh does this) — OneCLI transparently proxies its outbound
# HTTPS traffic and injects the real subscription token on the wire. There is
# no static gateway URL or token env var: the real token never lands here.
ONECLI_API_HOST=http://localhost:10264
ONECLI_AGENT=default

# Set both to 1 when serving over TLS behind nginx (docker-compose does this).
COOKIE_SECURE=0
TRUST_PROXY=0
